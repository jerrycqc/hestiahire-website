---
import { projectTypeOptions, site } from '../data/site';
---

<section id="contact" class="contact">
  <div class="contact__head">
    <div class="eyebrow">Get started</div>
    <h2>Tell us the role, we'll do the rest.</h2>
    <p>We read every submission ourselves and reply within one business day with next steps.</p>
  </div>

  <div class="contact__panel">
    <div class="contact__success" hidden>
      <div class="contact__success-title">Got it, thanks.</div>
      <div class="contact__success-body">We'll reach out within one business day to talk through what you need.</div>
    </div>

    <form
      class="contact__form"
      name="inquiry"
      method="POST"
      action="/thank-you/"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="inquiry" />
      <p class="visually-hidden">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>

      <div class="contact__row">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" required />
        </div>
      </div>
      <div class="contact__row">
        <div class="field">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" />
        </div>
        <div class="field">
          <label for="projectType">Role you need</label>
          <select id="projectType" name="projectType">
            {projectTypeOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
          </select>
        </div>
      </div>
      <div class="field">
        <label for="message">What's eating your week?</label>
        <textarea id="message" name="message" rows="4"></textarea>
      </div>
      <button type="submit" class="submit">Send request</button>
    </form>
  </div>

  <div class="contact__foot">
    <span>Prefer email? <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></span>
  </div>
</section>

<style>
  .contact__head {
    max-width: 560px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .eyebrow {
    font-size: 13.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin-bottom: 14px;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }

  .contact__head p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }

  .contact__panel {
    max-width: 640px;
    margin: 0 auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 40px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .contact__success {
    text-align: center;
    padding: 16px 0;
  }

  .contact__success-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .contact__success-body {
    font-size: 15px;
    color: var(--color-ink-soft);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact__form[hidden] {
    display: none;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field label {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .field input,
  .field select,
  .field textarea {
    padding: 13px 16px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border-strong);
    font-size: 15px;
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .field textarea {
    resize: vertical;
  }

  .submit {
    margin-top: 8px;
    padding: 16px 24px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--color-accent);
    color: var(--color-white);
    font-size: 15.5px;
    font-weight: 700;
    cursor: pointer;
  }

  .submit:hover {
    background: var(--color-accent-hover);
  }

  .contact__foot {
    text-align: center;
    margin-top: 24px;
    font-size: 14.5px;
    color: var(--color-ink-faint);
  }

  .contact__foot a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .contact__panel {
      padding: 28px;
    }

    .contact__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact__form');
  const success = document.querySelector<HTMLElement>('.contact__success');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const formData = new FormData(form);

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData as unknown as Record<string, string>).toString(),
      });

      if (!response.ok) throw new Error(`Form submission failed: ${response.status}`);

      form.hidden = true;
      success?.removeAttribute('hidden');
    } catch {
      // Fall back to a real navigation/submit so the request still reaches Netlify.
      form.submit();
    }
  });
</script>
