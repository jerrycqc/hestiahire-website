---
import { services } from '../data/site';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

const roleImages: Record<string, string> = {
  'Marketing Assistant': '/images/creative-team-review.jpg',
  'Executive Assistant': '/images/whiteboard-team.jpg',
  'Operations & Admin Assistant': '/images/puzzle-fit.jpg',
  'Customer Support Assistant': '/images/presenter-conference.jpg',
};
---

<section id="roles" class="roles">
  <div class="section-head">
    <div class="eyebrow">Roles we place</div>
    <h2>One dedicated hire, matched to the role that's eating your week.</h2>
    <p>Every HestiaHire assistant works full-time for you, and only you.</p>
  </div>
  <div class="roles__grid">
    {services.map((svc) => (
      <div class="role-card">
        <PhotoPlaceholder shape="square" src={roleImages[svc.title]} label={`${svc.title} at work`} />
        <div class="role-card__body">
          <div class="role-card__number">{svc.number}</div>
          <div class="role-card__title">{svc.title}</div>
          <div class="role-card__desc">{svc.desc}</div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .section-head {
    max-width: 600px;
    margin-bottom: 40px;
  }

  .eyebrow {
    font-size: 13.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin-bottom: 14px;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .section-head p {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }

  .roles__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .role-card__body {
    padding-top: 18px;
  }

  .role-card__number {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .role-card__title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .role-card__desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  @media (max-width: 980px) {
    .roles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .roles__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
